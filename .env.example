# Copy to .env (never commit .env) and fill in. Every setting is MKOPOGUARD_<NAME>.
# Generate a secret key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MKOPOGUARD_ENVIRONMENT=development
MKOPOGUARD_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
MKOPOGUARD_ACCESS_TOKEN_MINUTES=30
# Local default (SQLite file in the project root). Production: the Supabase Postgres URL (step 8.2)
# MKOPOGUARD_DATABASE_URL=sqlite:///./mkopoguard.db
# MKOPOGUARD_BUNDLE_DIR=models/champion
# MKOPOGUARD_FRONTEND_DIR=frontend
# MKOPOGUARD_SAMPLES_DIR=samples
MKOPOGUARD_LOG_LEVEL=INFO
# Login rate limits (step 5.7): attempts per IP per window, failures per IP+email per window
# MKOPOGUARD_LOGIN_ATTEMPTS_PER_IP=20
# MKOPOGUARD_LOGIN_IP_WINDOW_SECONDS=300
# MKOPOGUARD_LOGIN_FAILURES_PER_ACCOUNT=5
# MKOPOGUARD_LOGIN_FAILURE_WINDOW_SECONDS=900
